# DATABASE_URL apunta a Neon (pooler) en producción. Sin esta variable,
# el backend usa SQLite local para desarrollo (mismo patrón que backend_gal).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/wasi?sslmode=require

# API key estática para transport (X-Api-Key)
WASI_API_KEY=

# Login admin/taller
WASI_ADMIN_PASSWORD=
WASI_TALLER_PASSWORD=

# Supabase Storage (imágenes de productos / remitos)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=